{
  "name": "moneyprinter-water-rocket-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render WaterRocketDouyin out/water-rocket.mp4",
    "build-h264": "remotion render WaterRocketDouyin out/water-rocket-h264.mp4 --codec h264 --crf 16",
    "build-preview": "remotion render WaterRocketDouyin out/preview.mp4 --concurrency 1 --jpeg-quality 80",
    "build-still": "remotion still WaterRocketDouyin out/poster.png --frame=120",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/media-utils": "4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.4.5"
  }
}